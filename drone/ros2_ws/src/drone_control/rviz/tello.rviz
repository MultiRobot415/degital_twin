Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane Cell Count: 12
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
    - Class: rviz_default_plugins/Pose
      Name: TelloPose
      Enabled: true
      Topic:
        Value: /tello/pose
        Depth: 5
        Reliability Policy: Reliable
      Shape: Arrow
      Color: 0; 170; 255
    # 障害物マーカー（1機ぶんだけ表示＝三重描画による乱立を防ぐ）。
    # tello1 の obstacle_bridge が見ている集合＝「他機(tello2,3)＋静止障害物ID4,ID5」。
    # 静止障害物ID4/5は全機共通なので、この1つで両方見える。
    # 赤シリンダー=本体半径(static_obstacle_radius), 薄ピンク=安全境界(半径+robot_radius)。
    # latched QoS に合わせ Durability=Transient Local。
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles (tello1 view)
      Enabled: true
      Topic:
        Value: /tello1/shield/obstacles
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 6
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Pitch: 0.4
      Yaw: 0.8
